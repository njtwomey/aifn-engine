{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.render.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"],
