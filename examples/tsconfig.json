{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.examples.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "node"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "paths": {
      "@render/*": ["../packages/render/src/*"],
      "aifn-render": ["../packages/render/src/index.ts"],
      "aifn-render/*": ["../packages/render/src/*"],
      "@examples/*": ["./src/*"]
    }
  },
  "include": ["src", "plugins", "vite.config.ts", "check.ts"]
}
